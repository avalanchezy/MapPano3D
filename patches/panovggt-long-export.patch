+def load_precomputed_loop_pairs(loop_file):
+    loop_pairs = []
+    with open(loop_file, "r", encoding="utf-8") as f:
+        for line in f:
+            line = line.strip()
+            if not line or line.startswith("#"):
+                continue
+            parts = [p.strip() for p in line.split(",")]
+            if len(parts) < 2:
+                continue
+            loop_pairs.append((int(parts[0]), int(parts[1])))
+    return loop_pairs
+
